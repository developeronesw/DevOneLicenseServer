{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devone-license-server",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-25",
  "workers_dev": true,
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "d1_databases": [{ "binding": "DB", "database_name": "devone-license-db", "migrations_dir": "migrations" }],
  "kv_namespaces": [{ "binding": "LICENSE_KV" }],
  "r2_buckets": [{ "binding": "LICENSE_STORAGE" }]
}
